// ECMAScript 7.2.14 Abstract Equality Comparison — Lou port.
// Mirrors equality-coercion.js; uses console.log(label, val) so output
// matches Node's format ("label true" with the space from console.log).

try {
console.log("0==''", 0 == "");
console.log("0=='0'", 0 == "0");
console.log("''=='0'", "" == "0");
console.log("false=='0'", false == "0");
console.log("false==0", false == 0);
console.log("false==''", false == "");
console.log("true=='1'", true == "1");
console.log("true==1", true == 1);

console.log("null==undef", null == undefined);
console.log("null==null", null == null);
console.log("null==0", null == 0);
console.log("null==''", null == "");
console.log("undef==0", undefined == 0);
console.log("undef==''", undefined == "");

console.log("[1]==1", [1] == 1);
console.log("[]==0", [] == 0);
console.log("[]==''", [] == "");
console.log("[1]=='1'", [1] == "1");
console.log("[1,2]=='1,2'", [1, 2] == "1,2");
console.log("[] == false", [] == false);
console.log("[] == ![]", [] == ![]);

console.log("1==1.0", 1 == 1.0);
console.log("0==-0", 0 == -0);

console.log("0!==''", 0 !== "");
console.log("false!==0", false !== 0);
console.log("[]!==0", [] !== 0);
console.log("null!==undef", null !== undefined);

// NaN: Lou has no `NaN` global identifier; 0/0 produces it.
var nan = 0 / 0;
console.log("NaN==NaN", nan == nan);
console.log("NaN==0", nan == 0);
} catch (e) { console.log("error:", e); }
