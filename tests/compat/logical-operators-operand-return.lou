// Logical operators && and || must return operands (not booleans)
console.log("hello" || "world");
console.log(0 && 42);
console.log("" || "fallback");
console.log("truthy" && "yes");
console.log(false && "never");
console.log(true || "never");
console.log(0 || "" || "found");
console.log(1 && "hello" && "world");
