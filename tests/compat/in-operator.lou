const obj = { a: 1, b: 2, c: 3 };
console.log("a" in obj);
console.log("z" in obj);

const arr = [10, 20, 30];
console.log(0 in arr);
console.log(5 in arr);
console.log(2 in arr);

const key = "b";
console.log(key in obj);

const empty = {};
console.log("x" in empty);

console.log(!("missing" in obj));
