// Object.keys/values/entries and JSON.stringify follow [[OwnPropertyKeys]]:
// integer indices ascending first, then string keys in insertion order.
console.log(Object.keys({b: 1, 0: 2}));
console.log(Object.values({b: 1, 0: 2}));
console.log(Object.entries({b: 1, 0: 2}));
console.log(JSON.stringify({b: 1, 0: 2}));
console.log(JSON.stringify({2: 1, 1: 2}));
console.log(JSON.stringify({b: 1, 0: 2}, null, 2));
console.log(JSON.stringify({a: 1, b: 2}, ["b", "a"]));
console.log(Object.keys({z: 1, 10: 2, 2: 3, a: 4}));
