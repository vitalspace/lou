// String.prototype.replace with regex patterns
console.log("a1b2".replace(/[0-9]/g, "x"));
console.log("a1b2".replace(/[0-9]/, "x"));
console.log("2024-11-27".replace(/(\d+)-(\d+)-(\d+)/, "$3/$2/$1"));
console.log("Hello World".replace(/world/i, "there"));
console.log("abc".replace(/z/, "x"));
console.log("abc".replace(/b/) + "|");

// String.prototype.split with regex separators
console.log("a,b,c".split(/,/));
console.log("a,b,c".split(/,/, 2));
console.log("a,b".split(/,/, 0));
console.log("a1b2c".split(/[0-9]/));
console.log("a  b\tc".split(/\s+/));
console.log("abc".split(/z/));
console.log("".split(/,/));
console.log(",a".split(/,/));
console.log("a,,b".split(/,/));
