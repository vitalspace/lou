// instanceof operator tests
console.log("--- instanceof builtins ---");
console.log([] instanceof Array);
console.log({} instanceof Object);
console.log([] instanceof Object);
console.log((new Date()) instanceof Date);
console.log((new Date()) instanceof Object);

console.log("--- instanceof primitives (always false) ---");
console.log("hi" instanceof String);
console.log(42n instanceof BigInt);

console.log("--- instanceof with null/void/undefined ---");
console.log(null instanceof Object);
console.log(undefined instanceof Object);

console.log("--- instanceof negation ---");
console.log(!([] instanceof String));
console.log(!({} instanceof Array));
