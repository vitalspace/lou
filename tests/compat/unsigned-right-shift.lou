// Unsigned right shift test
console.log(-1 >>> 0);
console.log(-1 >>> 1);
console.log(8 >>> 1);
console.log(255 >>> 4);
console.log(1 >>> 0);
console.log(-8 >>> 2);
console.log(0 >>> 5);

// Compound assignments
var x = -1;
x >>>= 1;
console.log(x);

var y = 1;
y <<= 4;
console.log(y);

var z = 16;
z >>= 2;
console.log(z);
