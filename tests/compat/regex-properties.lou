const re = new RegExp("hello", "gi");
console.log(re.source);
console.log(re.flags);
console.log(re.global);
console.log(re.ignoreCase);
console.log(re.multiline);
console.log(re.unicode);
console.log(re.sticky);
console.log(re.lastIndex);

re.lastIndex = 3;
console.log(re.lastIndex);

re.lastIndex = 0;
console.log(re.lastIndex);

const simple = new RegExp("a", "");
console.log(simple.flags);
console.log(simple.global);
console.log(simple.ignoreCase);

const all = new RegExp("a", "gimsuy");
console.log(all.flags);
console.log(all.global);
console.log(all.ignoreCase);
console.log(all.multiline);
console.log(all.unicode);
console.log(all.sticky);
