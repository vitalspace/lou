// UpdateExpression (++/--) on MemberAccess and ArrayIndex
// Lou test - should match Node.js output

// --- Basic MemberAccess post-increment ---
let o = {x: 5, y: 10}
let r1 = o.x++
console.log(r1)
console.log(o.x)

// --- Basic MemberAccess pre-increment ---
let r2 = ++o.y
console.log(r2)
console.log(o.y)

// --- Basic ArrayIndex post-increment ---
let a = [1, 2, 3]
let r3 = a[0]++
console.log(r3)
console.log(a)

// --- Basic ArrayIndex pre-increment ---
let r4 = ++a[1]
console.log(r4)
console.log(a)

// --- Post-decrement MemberAccess ---
let stats = {hits: 10}
let r5 = stats.hits--
console.log(r5)
console.log(stats.hits)

// --- Pre-decrement ArrayIndex ---
let b = [5, 10, 15]
let r6 = --b[2]
console.log(r6)
console.log(b)

// --- Chained MemberAccess ---
let deep = {a: {b: 1}}
deep.a.b++
console.log(deep.a.b)

// --- Mixed with other operators ---
let arr = [100]
let r7 = arr[0]++ + 50
console.log(r7)
console.log(arr)

// --- Plain Identifier still works ---
let x = 5
let r8 = x++
console.log(r8)
console.log(x)

let r9 = ++x
console.log(r9)
console.log(x)

// --- Expression index ---
let c = [10, 20, 30]
let idx = 1
c[idx]--
console.log(c)
